NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000

DATABASE_URL=postgresql://shopify_sync:CHANGE_ME@127.0.0.1:5432/shopify_kiotviet
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379

SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=YOUR_ADMIN_API_ACCESS_TOKEN
SHOPIFY_API_SECRET=YOUR_APP_API_SECRET
SHOPIFY_API_VERSION=2026-07

KIOTVIET_CLIENT_ID=YOUR_CLIENT_ID
KIOTVIET_CLIENT_SECRET=YOUR_CLIENT_SECRET
KIOTVIET_RETAILER=shopqt
KIOTVIET_WEBHOOK_SECRET=YOUR_BASE64_WEBHOOK_SECRET

SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345678

WORKER_CONCURRENCY=3
JOB_MAX_ATTEMPTS=5
LOG_LEVEL=info
