NODE_ENV=development
APP_URL=http://localhost:3000
PUBLIC_APP_URL=https://your-sync-app.example.com
APP_PORT=3000

DATABASE_URL=postgresql://shopify_sync:CHANGE_ME@127.0.0.1:5432/shopify_kiotviet
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
# Required for BullMQ webhook processing. Use Docker Redis for local webhook tests.
REDIS_URL=redis://127.0.0.1:6379

SHOPIFY_SHOP=your-store
SHOPIFY_CLIENT_ID=YOUR_CLIENT_ID
SHOPIFY_CLIENT_SECRET=YOUR_CLIENT_SECRET
SHOPIFY_API_VERSION=2026-07

KIOTVIET_CLIENT_ID=YOUR_CLIENT_ID
KIOTVIET_CLIENT_SECRET=YOUR_CLIENT_SECRET
KIOTVIET_RETAILER=your-retailer-code
KIOTVIET_WEBHOOK_SECRET=YOUR_BASE64_WEBHOOK_SECRET

SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD

WORKER_CONCURRENCY=3
JOB_MAX_ATTEMPTS=5
LOG_LEVEL=info
